    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "6.0.7"
  }
}
